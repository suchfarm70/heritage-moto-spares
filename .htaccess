# ==============================================================================
# Heritage Moto Spares — Apache .htaccess Configuration
# CSET489 Technical SEO (Dr. Saumitra Gangwar & Dr. Amit Kumar)
# ==============================================================================

RewriteEngine On

# 1. Canonical Host & HTTPS Enforcement (One Single 301 Hop)
# Sends http:// and www. to https://heritagemotospares.com in ONE hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://heritagemotospares.com/$1 [L,R=301]

# 2. Strict Transport Security (HSTS) - Slide 27
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Browser Caching Headers (Cache-Control & Expires) - Slide 22, 29, 30
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML Documents (Fast revalidation for fresh stock)
  ExpiresByType text/html "access plus 1 hour"
  
  # CSS and JavaScript (Fingerprinted/Static assets)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  
  # Images (WebP, JPG, PNG, SVG)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 4. GZIP / Deflate Compression - Slide 30
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Prevent Crawl Traps & Parameter Loops - Slide 13 & 17
RewriteCond %{QUERY_STRING} ^(.*)sessionid=(.*)$ [NC]
RewriteRule ^(.*)$ https://heritagemotospares.com/$1? [R=301,L]
